 "derived": [
  {
   "id": "m_batt",
   "name": "Battery pack mass",
   "unit": "kg",
   "formula": "n_cells * m_cell + m_bms",
   "system": "battery"
  },
  {
   "id": "m_total",
   "name": "Total wet mass",
   "unit": "kg",
   "formula": "sum(m_struct, m_harness, m_fast, m_panels, m_batt, m_eps, m_obc, m_adcs, m_uhf, m_sband, m_cam, m_therm)",
   "system": "kestrel"
  },
  {
   "id": "f1",
   "name": "First natural frequency",
   "unit": "Hz",
   "formula": "f_ref * sqrt(6.0 / m_total)",
   "system": "structure"
  },
  {
   "id": "p_gen",
   "name": "Orbit-average generated power",
   "unit": "W",
   "formula": "area_cells * eff_cells * 1361 * cos_avg * sun_frac",
   "system": "solar"
  },
  {
   "id": "p_cons",
   "name": "Orbit-average consumed power",
   "unit": "W",
   "formula": "p_bus + p_adcs + p_cam * duty_cam + p_sband * duty_tx + p_heater",
   "system": "eps"
  },
  {
   "id": "pwr_ratio",
   "name": "Power generation / consumption",
   "unit": "",
   "formula": "p_gen / p_cons",
   "system": "eps"
  },
  {
   "id": "e_batt",
   "name": "Battery energy (BOL)",
   "unit": "Wh",
   "formula": "n_cells * cap_ah * v_cell",
   "system": "battery"
  },
  {
   "id": "p_ecl",
   "name": "Eclipse load",
   "unit": "W",
   "formula": "p_bus + p_adcs + p_heater",
   "system": "eps"
  },
  {
   "id": "p_peak",
   "name": "Peak discharge load",
   "unit": "W",
   "formula": "p_ecl + p_cam + p_sband",
   "system": "eps"
  },
  {
   "id": "dod_peak",
   "name": "Depth of discharge, worst eclipse with peak event",
   "unit": "",
   "formula": "(p_ecl * t_ecl + (p_cam + p_sband) * t_peak) / (e_batt * eta_batt)",
   "system": "battery"
  },
  {
   "id": "i_cell",
   "name": "Peak cell current",
   "unit": "A",
   "formula": "p_peak / (n_cells * v_cell)",
   "system": "battery"
  },
  {
   "id": "p_diss",
   "name": "Battery heat dissipation at peak",
   "unit": "W",
   "formula": "n_cells * r_int * sq(i_cell) + p_peak * (1 - eta_batt)",
   "system": "battery"
  },
  {
   "id": "t_batt_hot",
   "name": "Battery temperature, hot case",
   "unit": "°C",
   "formula": "t_hot + r_batt * p_diss",
   "system": "thermal"
  },
  {
   "id": "t_batt_cold",
   "name": "Battery temperature, cold case",
   "unit": "°C",
   "formula": "t_cold + r_batt * (p_heater + p_ecl * (1 - eta_batt))",
   "system": "thermal"
  },
  {
   "id": "t_cam",
   "name": "Camera detector temperature, hot case",
   "unit": "°C",
   "formula": "t_hot + r_cam * p_cam",
   "system": "thermal"
  },
  {
   "id": "inertia",
   "name": "Slew-axis inertia",
   "unit": "kg·m²",
   "formula": "k_inertia * m_total",
   "system": "adcs"
  },
  {
   "id": "t_slew",
   "name": "30° slew time (bang-bang)",
   "unit": "s",
   "formula": "2 * sqrt(0.5236 * inertia / torque)",
   "system": "adcs"
  },
  {
   "id": "dl_mb",
   "name": "Daily downlink capacity",
   "unit": "MB",
   "formula": "passes * pass_min * 60 * rate_mbps * link_eff / 8",
   "system": "sband"
  },
  {
   "id": "img_mb",
   "name": "Daily image data",
   "unit": "MB",
   "formula": "images * mb_img",
   "system": "camera"
  },
  {
   "id": "dl_ratio",
   "name": "Downlink capacity / image data",
   "unit": "",
   "formula": "dl_mb / img_mb",
   "system": "sband"
  }
 ],
